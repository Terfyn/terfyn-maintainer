# Copy to .env (which is gitignored) and fill in. scripts/terfyn-maintain.sh
# sources this file. Quote any value that contains spaces.

# Anthropic key — needed only for a real run. Offline (validate/plan/test) is
# static and needs no key. The agents use anthropic/claude-sonnet-5 (main.agent).
ANTHROPIC_API_KEY=

# Only for an identity-linked Anthropic key (not scoped to one workspace): the
# workspace id, sent as the anthropic-workspace-id header, read by the `provider
# anthropic` block in main.agent. A plain workspace-scoped key needs neither.
# ANTHROPIC_WORKSPACE_ID=

# GitHub token for the github tool (read the issue, open the PR, comment). A PAT
# with `repo` scope, or a fine-grained token with Contents + Pull requests +
# Issues read/write on the target repo.
GITHUB_TOKEN=

# The checkout the agents read and write — the workspace sandbox. read_file /
# write_file and the list_dir/glob/grep discovery ops are all confined to it; a
# ".." escape is rejected.
TERFYN_WORKSPACE_ROOT=/path/to/checkout

# What run_tests executes inside the workspace (quoted — it contains spaces).
TERFYN_WORKSPACE_TEST_COMMAND="go test ./..."

# The remote that push_branch targets.
TERFYN_GIT_REMOTE=origin
