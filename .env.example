# Copy to .env (which is gitignored) and fill in. scripts/terfyn-maintain.sh
# sources this file. Quote any value that contains spaces.

# Model provider key — needed only for a real run. Offline (validate/plan/test)
# uses the mock model and needs no key. For a real run also set the agents' model
# to anthropic/… in main.agent (or use OPENAI_API_KEY + an openai/… model).
ANTHROPIC_API_KEY=

# The checkout the agents read and write — the workspace sandbox. read_file /
# write_file are confined to it; a ".." escape is rejected.
TERFYN_WORKSPACE_ROOT=/path/to/checkout

# What run_tests executes inside the workspace (quoted — it contains spaces).
TERFYN_WORKSPACE_TEST_COMMAND="go test ./..."

# The remote that push_branch targets.
TERFYN_GIT_REMOTE=origin
