// terfyn-maintainer — a guarded autonomous PR fixer (DESIGN.md).
//
// Issue in → PR out. A Triager reads the GitHub issue, an Implementer and an
// independent Reviewer pass a CodingState back and forth inside a bounded
// `retry until state.approved limit 3`, then the workflow stops at the publication
// boundary — push the branch, OPEN the fix PR, and comment on the issue
// (git.push_branch + github.pull_request.create + github.issues.comment are
// approvals.requiredFor, so the run suspends for human approval).
//
// The whole program — agents, workflow, tools, and policies — is one .agent file
// (Terfyn inline declarations, ADR 005). Agent prompts live in prompts/*.md via
// `instructions file(...)` (#360); the two JSON schemas and project.yaml sit beside
// it. No custom code: all tools are Terfyn native adapters — workspace, git (#331),
// and github (issues.get, pull_request.create, …).
//
//   terfyn validate   terfyn plan   terfyn test   terfyn apply --auto-approve
//
// validate/plan/test are static (no API key). Executing the loop needs a real model
// key + a workspace sandbox (TERFYN_WORKSPACE_ROOT + TERFYN_WORKSPACE_TEST_COMMAND) +
// GITHUB_TOKEN; push uses TERFYN_GIT_REMOTE (default origin).

// ─────────────────────────────── agents ───────────────────────────────

agent Triager {
    model anthropic/claude-sonnet-5
    policy triage-readonly

    instructions file("prompts/triager.md")

    grants {
        tool.github.issues.get
        tool.workspace.read_file
        tool.workspace.run_tests
    }

    // Exploring a real repo (list dirs, read files, run tests) takes more than the
    // default 8 reason→act turns; bounded well under Terfyn's hard cap of 32.
    constraints { maxIterations 20 }

    input FixTask
    output CodingState
}

agent Implementer {
    model anthropic/claude-sonnet-5
    policy coding-agent

    instructions file("prompts/implementer.md")

    grants {
        tool.workspace.read_file
        tool.workspace.write_file
        tool.workspace.run_tests
    }

    // The Implementer does the most tool work (explore, edit, run tests, iterate).
    constraints { maxIterations 30 }

    input CodingState
    output CodingState
}

agent Reviewer {
    model anthropic/claude-sonnet-5
    policy reviewer

    instructions file("prompts/reviewer.md")

    grants {
        tool.workspace.read_file
        tool.workspace.run_tests
    }

    constraints { maxIterations 20 }

    input CodingState
    output CodingState
}

// ────────────────────────────── workflow ──────────────────────────────

workflow FixPullRequest(input: FixTask) -> CodingState
    policy publishing
    effects {
        github.read, github.write, workspace.read, workspace.write,
        process.exec, repository.write, network.write
    }
{
    state = Triager(input)

    git.create_branch(name: "terfyn/fix-${input.number}")

    // Bounded retry: run implement→review up to 3 times and proceed only once the
    // Reviewer approves. On exhaustion (3 rejected rounds) `retry until` fails the run
    // deterministically — it does NOT fall through to publication. This is the #361
    // construct that replaces the earlier `while … limit 3` + `if !approved` guard.
    retry until state.approved limit 3 {
        implementation = Implementer(state)
        state          = Reviewer(implementation)
    }

    // ── publication boundary — reached only when approved; all three are approvals.requiredFor ──
    git.push_branch(branch: "terfyn/fix-${input.number}")
    pr = github.pull_request.create(
        owner: input.owner,
        repo: input.repo,
        head: "terfyn/fix-${input.number}",
        base: "main",
        title: "${state.summary}",
        body: """
        ## Automated fix

        ${state.summary}

        Fixes #${input.number}.
        """
    )
    github.issues.comment(
        owner: input.owner,
        repo: input.repo,
        number: input.number,
        body: "Opened a fix PR: ${pr.html_url}"
    )

    return state
}

// ─────────────────────────────── tools ────────────────────────────────
// All native (Terfyn v0.3.0). read_file/write_file/run_tests are sandboxed to
// TERFYN_WORKSPACE_ROOT; git.push_branch refuses the default branch and is gated.

tool workspace {
    type native
    safety { trusted true   sideEffects true }
    operations {
        read_file  { effects { workspace.read } }
        write_file { effects { workspace.write } }
        run_tests  { effects { process.exec } }
    }
}

tool github {
    type native
    safety { trusted true   sideEffects true }
    operations {
        issues.get          { effects { github.read } }   // read the issue to fix
        pull_request.create { effects { github.write } }  // open the fix PR — the deliverable
        issues.comment      { effects { github.write } }  // link the PR back on the issue
    }
}

tool git {
    type native
    safety { trusted true   sideEffects true }
    operations {
        create_branch { effects { repository.write } }   // local ref
        push_branch   { effects { network.write } }      // publication boundary
    }
}

// ────────────────────────────── policies ──────────────────────────────

policy triage-readonly {
    execution { maxTotalCostUsd 5   maxWallClockSeconds 300 }
    effects { permit { github.read   workspace.read   process.exec } }
}

policy coding-agent {
    execution { maxTotalCostUsd 10   maxWallClockSeconds 600 }
    effects { permit { workspace.read   workspace.write   process.exec } }
}

policy reviewer {
    // Read + test only. workspace.write is absent, so the Reviewer cannot reach it.
    execution { maxTotalCostUsd 5   maxWallClockSeconds 300 }
    effects { permit { workspace.read   process.exec } }
}

policy publishing {
    // The workflow-level policy: permits non-publishing effects unattended and gates
    // the two publishing operations behind human approval (run suspends, exit 0).
    execution { maxTotalCostUsd 20   maxWallClockSeconds 900 }
    approvals {
        requiredFor {
            tool.git.push_branch
            tool.github.pull_request.create
            tool.github.issues.comment
        }
    }
    effects {
        permit             { github.read   workspace.read   workspace.write   process.exec   repository.write }
        permitWithApproval { network.write   github.write }
    }
}
